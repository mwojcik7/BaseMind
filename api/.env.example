APP_NAME=BaseMind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=basemind
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Minutes without activity (30 days): the PWA should keep you signed in on your phone.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@basemind.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- BaseMind ---
# Owner e-mail: receives security alerts (e.g. vulnerable PHP version).
BASEMIND_OWNER_EMAIL=
# Code required to create an account. Empty = registration is off.
# Generate a long random one: php -r "echo bin2hex(random_bytes(16));"
BASEMIND_REGISTRATION_CODE=
# Encrypts sensitive fields and files. Generate with: php artisan basemind:key
# LOSING THIS KEY MEANS LOSING THE ENCRYPTED DATA: keep a copy in a password manager.
SODIUM_KEY=
# Older keys, comma-separated, only used to decrypt. Set by: php artisan basemind:key --rotate
SODIUM_PREVIOUS_KEYS=

# --- Production checklist (shared hosting) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.tld
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=your-domain.tld
# BASEMIND_REGISTRATION_CODE= (empty after creating your account)
# SODIUM_KEY= (a new one for production, with a copy in a password manager)
# DB_USERNAME / DB_PASSWORD = dedicated user from hosting panel (never root)
# MAIL_MAILER=smtp + MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD from hosting

# SPA (PWA) origins that get cookie-based auth. Vite dev server + Apache.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080
